# Things MCP Server Configuration
# Copy this file to .env and modify the values as needed

# Server binding configuration
# Default: 127.0.0.1 (localhost only)
# Use 0.0.0.0 to allow remote connections
THINGS_MCP_HOST=127.0.0.1

# Server port configuration
# Default: 8009
THINGS_MCP_PORT=8009

# Things authentication token (REQUIRED for URL scheme operations)
# Get this from Things → Settings → General → Enable Things URLs
# Without this token, create/update/delete operations will fail silently
THINGS_AUTH_TOKEN=your-token-here

# Server API key (auto-generated on first run if empty)
# All MCP clients must send this as: Authorization: Bearer <key>
# If you delete this line, a new key will be generated on next startup
# THINGS_MCP_API_KEY=tmcp_your-key-here

# Debug mode (optional)
# Set to true to enable verbose debug logging to console
# Default: false (console shows INFO level only, DEBUG goes to log files)
# THINGS_MCP_DEBUG=false

# Client configuration examples:
#
# Claude Desktop (claude_desktop_config.json):
#   "things": {
#     "url": "http://localhost:8009/mcp",
#     "headers": {"Authorization": "Bearer tmcp_your-key-here"}
#   }
#
# n8n MCP Client Tool:
#   URL: http://localhost:8009/mcp
#   Headers: Authorization: Bearer tmcp_your-key-here
#
# ChatGPT:
#   URL: http://localhost:8009/mcp
#   Headers: Authorization: Bearer tmcp_your-key-here
