# Things FastMCP Server Configuration
# Copy this file to .env and modify the values as needed

# Server binding configuration
# Default: 127.0.0.1 (localhost only)
# Use 0.0.0.0 to allow remote connections
THINGS_FASTMCP_HOST=127.0.0.1

# Server port configuration
# Default: 8009
# Use any available port number
THINGS_FASTMCP_PORT=8009

# Example configurations:
# For remote access:
# THINGS_FASTMCP_HOST=0.0.0.0
# THINGS_FASTMCP_PORT=9000

# For custom port only:
# THINGS_FASTMCP_PORT=8080
